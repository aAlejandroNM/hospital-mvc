<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="SmokeSuite" verbose="1" parallel="false">
    <test name="Smoke-Service-And-Parsing">
        <parameter name="jsonFilePath" value="src/main/resources/json/medical-document.json"/>
        <groups>
            <run>
                <include name="service"/>
                <include name="integration"/>
            </run>
        </groups>
        <classes>
            <class name="com.solvd.hospital.service.PatientServiceImplTest"/>
            <class name="com.solvd.hospital.service.ClinicalServicesTest"/>
            <class name="com.solvd.hospital.integration.ParsingIntegrationTest"/>
        </classes>
    </test>
</suite>


